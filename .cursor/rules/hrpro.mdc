  sessionId?: string;
}

// ОБЯЗАТЕЛЬНО: Структурированное логирование
export class Logger {
  static log(level: LogLevel, message: string, context?: any): void {
    const entry: LogEntry = {
      timestamp: new Date().toISOString(),
      level,
      service: this.getServiceName(),
      message,
      context: this.sanitizeContext(context)
    };
    
    console.log(JSON.stringify(entry));
  }
}
```

**Правила логирования:**
* ✅ Использовать структурированные JSON логи
* ✅ Включать timestamp и session ID
* ✅ Логировать все ошибки с контекстом
* ✅ Маскировать чувствительные данные
* ✅ Разные уровни логирования (debug, info, warn, error)
* ❌ НЕ логировать API ключи или пароли
* ❌ НЕ использовать console.log для production логирования

### **2. Performance Monitoring (ОБЯЗАТЕЛЬНО)**

**Метрики для мониторинга:**
```typescript
interface PerformanceMetrics {
