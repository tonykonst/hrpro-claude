# ╔════════════════════════════════════════════════════════════════════════════╗
# ║                     INTERVIEW ASSISTANT CONFIGURATION                      ║
# ╚════════════════════════════════════════════════════════════════════════════╝
#
# Copy this file to .env and configure your settings
#
# TO DISABLE BROWSER AUDIO CAPTURE:
# ==================================
# Set REACT_APP_ENABLE_BROWSER_CAPTURE=false
# This will disable ALL browser audio capture features and fall back to microphone

# ============================================================================
# API KEYS
# ============================================================================

# Deepgram API for speech-to-text (get from console.deepgram.com)
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# OpenAI API for Whisper transcription (get from platform.openai.com)
OPENAI_API_KEY=your_openai_api_key_here

# Claude API for AI analysis (get from console.anthropic.com)
CLAUDE_API_KEY=your_claude_api_key_here

# Post-Editor API for ASR correction (can use same key as Claude)
POST_EDITOR_API_KEY=your_post_editor_api_key_here

# ============================================================================
# BROWSER CAPTURE FEATURE FLAGS
# ============================================================================
# Control browser audio capture features
# Set to false to disable, true to enable

# Master switch - Set to false to disable ALL browser capture
REACT_APP_ENABLE_BROWSER_CAPTURE=true

# Future system audio capture (Phase 2 - not yet implemented)
REACT_APP_ENABLE_SYSTEM_AUDIO=false

# Browser-specific features
REACT_APP_ENABLE_CHROME_EXTENSION=true      # Chrome/Edge extension support
REACT_APP_ENABLE_SAFARI_CAPTURE=true        # Safari screen capture
REACT_APP_ENABLE_FIREFOX_CAPTURE=true       # Firefox support

# UI Features
REACT_APP_ENABLE_AUDIO_SOURCE_SELECTOR=true # Audio source dropdown
REACT_APP_ENABLE_CROSS_BROWSER_UI=true      # Browser-specific UI
REACT_APP_ENABLE_AUDIO_VISUALIZER=true      # Audio level meters
REACT_APP_ENABLE_PERMISSION_PROMPTS=false   # Custom permission dialogs

# Advanced Features
REACT_APP_ENABLE_AUTO_SOURCE_FALLBACK=true  # Auto-fallback on errors
REACT_APP_ENABLE_QUALITY_ADAPTATION=true    # Dynamic quality adjustment
REACT_APP_ENABLE_DEBUG_MODE=false           # Debug information overlay
REACT_APP_ENABLE_TELEMETRY=false           # Anonymous usage statistics

# ============================================================================
# DEEPGRAM SETTINGS
# ============================================================================

DEEPGRAM_MODEL=nova-2-meeting
DEEPGRAM_LANGUAGE=
DEEPGRAM_PUNCTUATION=true
DEEPGRAM_INTERIM_RESULTS=true
DEEPGRAM_SMART_FORMAT=true
DEEPGRAM_ENDPOINTING=800
DEEPGRAM_VAD_EVENTS=true
DEEPGRAM_NO_DELAY=true
DEEPGRAM_INTERIM_PERIOD=100

# ============================================================================
# OPENAI WHISPER SETTINGS
# ============================================================================

OPENAI_WHISPER_MODEL=whisper-1
OPENAI_WHISPER_TEMPERATURE=0.0
OPENAI_WHISPER_LANGUAGE=
OPENAI_WHISPER_PROMPT=This is a technical interview. Terms may include: API, React, TypeScript, Docker, Kubernetes, DevOps, CI/CD, machine learning, microservices, architecture, development.

# ============================================================================
# CLAUDE SETTINGS
# ============================================================================

CLAUDE_MODEL=claude-sonnet-4-20250514
CLAUDE_MAX_TOKENS=300
CLAUDE_TEMPERATURE=0.3

# ============================================================================
# POST-EDITOR SETTINGS
# ============================================================================

POST_EDITOR_MODEL=claude-3-haiku-20240307
POST_EDITOR_MAX_TOKENS=150
POST_EDITOR_TEMPERATURE=0.1
POST_EDITOR_MAX_RPS=1
POST_EDITOR_TIMEOUT_MS=250
POST_EDITOR_ENABLED=true

# ============================================================================
# AUDIO SETTINGS
# ============================================================================

AUDIO_SAMPLE_RATE=16000
AUDIO_CHANNELS=1
AUDIO_ECHO_CANCELLATION=true
AUDIO_NOISE_SUPPRESSION=true
AUDIO_AUTO_GAIN_CONTROL=true
AUDIO_CHUNK_SIZE=250

# ============================================================================
# BROWSER CAPTURE CONFIGURATION
# ============================================================================

# Default audio source (microphone, browser-tab, screen-with-audio)
REACT_APP_DEFAULT_AUDIO_SOURCE=microphone

# Preferred browser for capture (chrome, safari, auto)
REACT_APP_PREFERRED_BROWSER=auto

# Audio quality preset (low, medium, high)
REACT_APP_AUDIO_QUALITY=high

# Capture operation timeout (milliseconds)
REACT_APP_CAPTURE_TIMEOUT=30000

# Chrome Extension Settings
REACT_APP_CHROME_EXTENSION_ID=YOUR_EXTENSION_ID_HERE
REACT_APP_CHROME_EXTENSION_URL=https://chrome.google.com/webstore/detail/hrpro-audio-capture/YOUR_EXTENSION_ID_HERE

# Safari Settings
REACT_APP_SAFARI_MIN_VERSION=13
REACT_APP_SAFARI_SCREEN_CAPTURE_DELAY=1000
REACT_APP_SAFARI_AUDIO_CHECK_INTERVAL=500

# ============================================================================
# UI SETTINGS
# ============================================================================

UI_INSIGHT_FREQUENCY_MS=3000
UI_MIN_INSIGHT_CONFIDENCE=0.6
UI_TRANSCRIPT_BUFFER_WORDS=600
UI_MAX_INSIGHTS_DISPLAY=3
UI_DEFAULT_ACTIVE_PANEL=transcript
UI_DEFAULT_CLICK_THROUGH=false

# Show UI elements
REACT_APP_SHOW_SOURCE_SELECTOR=true
REACT_APP_SHOW_AUDIO_LEVEL_METER=true
REACT_APP_SHOW_PERMISSION_DIALOGS=true
REACT_APP_SHOW_LIMITATIONS=true

# Screen width threshold for compact mode
REACT_APP_COMPACT_MODE_THRESHOLD=768

# ============================================================================
# ENVIRONMENT
# ============================================================================

NODE_ENV=development